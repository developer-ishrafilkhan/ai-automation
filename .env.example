APP_NAME="AI Automation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Choose your database (sqlite or mysql)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aiautomation
DB_USERNAME=root
DB_PASSWORD=

# Or for SQLite:
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Per-workspace vault encryption master key (AES-256-GCM)
# Generate via: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
VAULT_MASTER_KEY=

# Must exceed the longest step (RunStep::$timeout = 900s), or the queue starts a second copy of a slow AI call.
DB_QUEUE_RETRY_AFTER=1000

# Optional: One-click connectors that need a pre-registered OAuth app (redirect URI: ${APP_URL}/connectors/oauth/callback)
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_SECRET=
HUBSPOT_MCP_CLIENT_ID=
HUBSPOT_MCP_CLIENT_SECRET=

# ffmpeg joins the scenes of long videos. Leave empty to use ffmpeg from PATH.
FFMPEG_PATH=
